[18.942848, "o", "\r\n\u001b[1m\u001b[36m┌────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[36m│\u001b[0m \u001b[1m\u001b[37mSCENE 5: Multi-Agent Architecture                          \u001b[1m\u001b[36m│\u001b[0m\r\n\u001b[1m\u001b[36m└────────────────────────────────────────────────────────────┘\u001b[0m\r\n  \u001b[34m▶\u001b[0m Aegis supports orchestrator -> specialist delegation patterns:\r\n\r\n  \u001b[1m\u001b[36mOrchestratorAgent\u001b[0m\r\n  \u001b[2m│  Analyzes treasury state via Venice AI\u001b[0m\r\n  \u001b[2m│  Validates risk limits (single trade, daily volume, slippage)\u001b[0m\r\n  \u001b[2m│  Creates scoped sub-delegations for specialists\u001b[0m\r\n  \u001b[2m├───────────────────────────────────────┐\u001b[0m\r\n  \u001b[2m│\u001b[0m                                       \u001b[2m│\u001b[0m\r\n  \u001b[1m\u001b[32mSwapAgent\u001b[0m                               \u001b[1m\u001b[33mTransferAgent\u001b[0m\r\n  \u001b[2mScoped to: Uniswap Router only\u001b[0m          \u001b[2mScoped to: recipient only\u001b[0m\r\n  \u001b[2m  Target   :\u001b[0m \u001b[37m0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4\u001b[0m\r\n  \u001b[2mStrategy: Momentum analysis\u001b[0m             \u001b[2mStrategy: DCA chunking\u001b[0m\r\n  \u001b[2mChecks trend + confidence before\u001b[0m       \u001b[2mSplits large transfers into\u001b[0m\r\n  \u001b[2mexecuting any swap\u001b[0m                      \u001b[2msmaller timed chunks\u001b[0m\r\n\r\n  \u001b[34m▶\u001b[0m Each specialist receives a scoped MetaMask delegation:\r\n  \u001b[34m▶\u001b[0m   - Limited to specific contract targets\r\n  \u001b[34m▶\u001b[0m   - Capped token transfer amount\r\n  \u001b[34m▶\u001b[0m   - Time-bounded (1 hour expiry for sub-delegations)\r\n  \u001b[34m▶\u001b[0m   - Risk-validated before execution\r\n"]
[20.443399, "o", "\r\n"]
[20.443873, "o", "\u001b[1m\u001b[36m┌────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[36m│\u001b[0m \u001b[1m\u001b[37mSCENE 6: MetaMask Delegation Framework                     \u001b[1m\u001b[36m│\u001b[0m\r\n\u001b[1m\u001b[36m└────────────────────────────────────────────────────────────┘\u001b[0m\r\n  \u001b[34m▶\u001b[0m Creating a delegation with CaveatBuilder...\r\n\r\n  \u001b[1m\u001b[37mDelegation Structure:\u001b[0m\r\n  \u001b[2m┌────────────────────────────────────────────────┐\u001b[0m\r\n  \u001b[2m│\u001b[0m \u001b[1mfrom:\u001b[0m  Treasury Owner (Smart Account)      \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m \u001b[1mto:\u001b[0m    AI Agent (EOA)                      \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m \u001b[1mscope:\u001b[0m erc20TransferAmount (USDC, 500 max) \u001b[2m│\u001b[0m\r\n  \u001b[2m├────────────────────────────────────────────────┤\u001b[0m\r\n  \u001b[2m│\u001b[0m \u001b[1mCaveats:\u001b[0m                                    \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m   1. allowedTargets: [recipient]           \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m   2. timestamp: expires 2026-03-23       \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m   3. erc20TransferAmount: max 500 USDC     \u001b[2m│\u001b[0m\r\n  \u001b[2m└────────────────────────────────────────────────┘\u001b[0m\r\n\r\n  \u001b[34m▶\u001b[0m EIP-712 Signing Flow:\r\n"]
[20.443894, "o", "  \u001b[34m▶\u001b[0m   1. CaveatBuilder assembles enforcer constraints\r\n"]
[20.443951, "o", "  \u001b[34m▶\u001b[0m   2. createDelegation() produces an unsigned delegation\r\n  \u001b[34m▶\u001b[0m   3. signDelegation() signs via EIP-712 typed data\r\n"]
[20.443971, "o", "  \u001b[34m▶\u001b[0m   4. Agent presents signed delegation to DelegationManager"]
[20.444013, "o", "\r\n  \u001b[34m▶\u001b[0m   5. On-chain verification of signature + all caveat enforcers\r\n"]
[20.444031, "o", "  \u001b[34m▶\u001b[0m   6. If valid, execution proceeds through the smart account\r\n"]
[20.444075, "o", "\r\n"]
[20.444346, "o", "  \u001b[32m✔\u001b[0m \u001b[32mDelegations replace raw allowances with composable, time-bounded permissions\u001b[0m\r\n"]
[21.946127, "o", "\r\n\u001b[1m\u001b[36m┌────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1m\u001b[36m│\u001b[0m \u001b[1m\u001b[37mSCENE 7: Summary                                           \u001b[1m\u001b[36m│\u001b[0m\r\n\u001b[1m\u001b[36m└────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n  \u001b[2mOn-chain transactions:\u001b[0m \u001b[37m1\u001b[0m\r\n  \u001b[34m▶\u001b[0m Transaction links:\r\n    \u001b[32mhttps://sepolia.basescan.org/tx/0xd15d26a19203354f79e42d0fa391b635fc8d74408e6f737299c1bd38e13c535b\u001b[0m\r\n\r\n  \u001b[34m▶\u001b[0m Contract links:\r\n    \u001b[34mTreasury: https://sepolia.basescan.org/address/0x33E42b7db9569fb4f3cd6d68180fcC007AE6ece7\u001b[0m\r\n    \u001b[34mAgent:    https://sepolia.basescan.org/address/0x8a492261655c48997D79d1d479a7c6E5A32deeD9\u001b[0m\r\n\r\n\u001b[2m  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─  ─\u001b[0m\r\n\r\n  \u001b[1m\u001b[35mBuilt at The Synthesis by Anish De and Opus\u001b[0m\r\n\r\n"]
